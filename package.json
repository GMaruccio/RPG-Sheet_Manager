{
  "name": "dnd-sheet",
  "version": "1.0.0",
  "description": "Gerador simples de fichas de RPG D&D 5e com testes automatizados e CI",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "test:unit": "jest tests/unit --coverage --coverageDirectory=results/coverage --json --outputFile=results/unit.json",
    "test:integration": "jest tests/integration --json --outputFile=results/integration.json",
    "test:performance": "jest tests/performance --runInBand --json --outputFile=results/performance.json",
    "test": "npm run test:unit && npm run test:integration && npm run test:performance",
    "summary": "node scripts/summary.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/character.js",
      "src/store.js"
    ],
    "coverageReporters": [
      "text",
      "json-summary",
      "lcov"
    ]
  }
}